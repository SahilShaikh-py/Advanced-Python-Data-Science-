    "[![Open In Colab](https://colab.research.google.com/assets/colab-badge.svg)](https://colab.research.google.com/github/SahilShaikh-py/Advanced-Python-Data-Science-/blob/main/01-python-ds-foundations/01_advanced_python_oops.ipynb)\n",
    "\n",
    "## 📌 1. Theory & Intuition\n",
    "- **Class vs Instance:** A Class is a blueprint defining attributes and methods. An instance (`obj = Preprocessor()`) allocates memory.\n",
    "- **Encapsulation:** Hiding internal state logic and exposing clean interfaces (`fit()`, `transform()`).\n",
    "- **Generators:** Using `yield` to stream large datasets without loading entire files into RAM."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 💻 Live Demo: Building a Scikit-Learn style Data Preprocessor Class\n",
    "class DataPipeline:\n",
    "    def __init__(self, feature_name):\n",
    "        # Explanation: Store the target feature name as instance attribute\n",
    "        self.feature_name = feature_name\n",
    "        self.mean = None\n",
    "        self.std = None\n",
    "\n",
    "    def fit(self, data_list):\n",
    "        # Explanation: Calculate mean and standard deviation from training data\n",
    "        self.mean = sum(data_list) / len(data_list)\n",
    "        variance = sum((x - self.mean) ** 2 for x in data_list) / len(data_list)\n",
    "        self.std = variance ** 0.5\n",
    "        print(f"[FIT COMPLETE] Feature '{self.feature_name}' | Mean: {self.mean:.2f}, Std: {self.std:.2f}")\n",
    "\n",
    "    def transform(self, data_list):\n",
    "        # Explanation: Standardize list using Z-score formula (x - mean) / std\n",
    "        return [(x - self.mean) / self.std for x in data_list]\n",
    "\n",
    "# Test Pipeline\n",
    "pipeline = DataPipeline(feature_name=\"Salary\")\n",
    "raw_salaries = [45000, 55000, 65000, 75000, 85000]\n",
    "pipeline.fit(raw_salaries)\n",
    "standardized_salaries = pipeline.transform(raw_salaries)\n",
    "print(\"Standardized Salaries:\", [round(x, 2) for x in standardized_salaries])"
   ]
  },
